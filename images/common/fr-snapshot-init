#!/bin/sh
# Turn the copied snapshot into a single fresh commit (no history, refs, reflog).
# Usage (in a task Dockerfile, WORKDIR = repo): RUN fr-snapshot-init
set -eu
if [ -f .beads/config.yaml ]; then
    # bd's sync remote would pull today's issue database (later than the snapshot),
    # if the dev-stack toolkit is enabled. Both spellings: "sync.remote: x" and a
    # "sync:" block with an indented "remote:".
    awk '
        /^sync\.remote:/ { next }
        /^sync:[[:space:]]*$/ { insync = 1; print; next }
        insync && /^[[:space:]]+remote:/ { next }
        /^[^[:space:]]/ { insync = 0 }
        { print }
    ' .beads/config.yaml > .beads/config.yaml.tmp && mv .beads/config.yaml.tmp .beads/config.yaml
fi
git init -q
# No automatic background gc: it races the explicit gc below on large snapshots.
git config gc.auto 0
git add -A
git commit -qm init
git reflog expire --expire=now --all
git gc -q --prune=now
