# fitting-room repo image for a uv-managed Python repo (CPU).
# Build context is generated by images/build.sh: warm/pyproject.toml and warm/uv.lock
# from a recent commit, used only to install the interpreter and the shared venv.
ARG BASE=fr-base/cpu:1
FROM ${BASE}
ARG PYTHON
ARG SYNC_ARGS="--all-extras --all-groups"
# Task images inherit these: uv uses the repo's interpreter and syncs into /opt/venv.
ENV UV_PYTHON=${PYTHON} FR_SYNC_ARGS=${SYNC_ARGS} \
    UV_PROJECT_ENVIRONMENT=/opt/venv VIRTUAL_ENV=/opt/venv
# The image holds the interpreter and one venv, nothing else. The uv cache (wheels,
# compiled sdists such as free-threaded opencv) lives in a BuildKit cache mount shared by
# every repo image and task build (id fr-uv-cache), so it is stored once, not per image.
# warm/ is bind-mounted, so it is not left behind in a layer.
RUN --mount=type=bind,source=warm,target=/opt/warm,rw \
    --mount=type=cache,id=fr-uv-cache,target=/opt/uv-cache,sharing=locked \
    cd /opt/warm && uv sync --frozen --no-install-project ${SYNC_ARGS}
# Last: shared helper scripts (cheap to rebuild).
COPY fr-snapshot-init /usr/local/bin/fr-snapshot-init
