# fitting-room repo image for a uv-managed Python repo (CPU).
# Build context is generated by images/build.sh: warm/pyproject.toml and warm/uv.lock
# from a recent commit, used only to fill the uv cache and install the interpreter.
ARG BASE=fr-base/cpu:1
FROM ${BASE}
ARG PYTHON
ARG SYNC_ARGS="--all-extras --all-groups"
# Task images inherit this: uv uses the same interpreter as the repo's own venv.
ENV UV_PYTHON=${PYTHON} FR_SYNC_ARGS=${SYNC_ARGS}
COPY warm/ /opt/warm/
RUN cd /opt/warm && uv sync --frozen --no-install-project ${SYNC_ARGS} \
    && rm -rf /opt/warm/.venv
# Shared venv, built once: task images sync into it and add only what differs at their
# commit, instead of copying every dependency into a per-task .venv. (Separate step and
# ENV placed after the warm-up so the cached warm-up layer is reused.)
ENV UV_PROJECT_ENVIRONMENT=/opt/venv VIRTUAL_ENV=/opt/venv
RUN cd /opt/warm && uv sync --frozen --no-install-project --offline ${SYNC_ARGS}
# Last: shared helper scripts (cheap to rebuild).
COPY fr-snapshot-init /usr/local/bin/fr-snapshot-init
