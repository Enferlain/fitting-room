# fitting-room repo image for a uv-managed Python repo (CPU).
# Build context is generated by images/build.sh: warm/pyproject.toml and warm/uv.lock
# from a recent commit, used only to fill the uv cache and install the interpreter.
ARG BASE=fr-base/cpu:1
FROM ${BASE}
ARG PYTHON
# Task images inherit this: uv uses the same interpreter as the repo's own venv.
ENV UV_PYTHON=${PYTHON}
COPY warm/ /opt/warm/
RUN cd /opt/warm && uv sync --frozen --no-install-project --all-extras --all-groups \
    && rm -rf /opt/warm/.venv
